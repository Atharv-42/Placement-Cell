# Example environment variables for the backend
# Copy this file to `.env` and fill in real values (DO NOT commit secrets)

# MongoDB connection string (Atlas SRV). Replace <username>, <password>, <cluster-host>
# Example: mongodb+srv://user:pass@cluster0.abcd.mongodb.net/placementPortal?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/placementPortal?retryWrites=true&w=majority

# JWT signing secret
JWT_SECRET=your_jwt_secret_here

# Set to true only for demos when you want to skip email verification entirely
DISABLE_EMAIL_VERIFICATION=false

# Frontend URL used in email verification links
FRONTEND_URL=http://localhost:5173

# SMTP settings for email verification
# For Gmail, use an app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Placement Cell Portal <your_email@gmail.com>"
